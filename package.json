{
  "name": "agent-instructions",
  "version": "0.0.0",
  "packageManager": "pnpm@8.11.0",
  "private": true,
  "description": "Dummy package manifest to enable CI caching of Node tooling; replace with real dependencies when needed.",
  "license": "UNLICENSED",
  "scripts": {
    "env:summary": "node -e \"console.log('Environment OK')\"",
    "orchestrate:dry": "node ./scripts/orchestrator.mjs --dry-run --workflow sample-minimal",
    "orchestrate:dry:file": "node ./scripts/orchestrator.mjs --dry-run --file",
    "test:dcv": "bash ./tests/dcv-docker/test.sh",
    "test:dcv:22": "bash ./tests/dcv-docker/test.sh 22.04",
    "test:dcv:24": "bash ./tests/dcv-docker/test.sh 24.04",
    "test:dcv:win": "pwsh -ExecutionPolicy Bypass -File ./tests/dcv-docker/test.ps1",
    "test:dcv:win:22": "pwsh -ExecutionPolicy Bypass -File ./tests/dcv-docker/test.ps1 -UbuntuVersion 22.04",
    "test:dcv:win:24": "pwsh -ExecutionPolicy Bypass -File ./tests/dcv-docker/test.ps1 -UbuntuVersion 24.04"
  },
  "engines": {
    "node": ">=22"
  }
}
